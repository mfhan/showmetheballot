  "ballotMeasures": [
    {
      "title": "Austin, Texas, Proposition P, Extraterritorial Jurisdiction Measure (November 2024)",
      "propositionId": "P",
      "fullText": "\u201cShall an untaxed area in the City of Austin's extraterritorial jurisdiction, containing 35 lots on approximately 96.9 acres of land on Menchaca Road south of Slaughter Lane, be released from the City of Austin's extraterritorial jurisdiction and into unincorporated Travis County, with the result that the Area will no longer be governed by the City's environmental and development regulations?\u201d",
      "type": "Ballot Measure",
      "level": "Special District"
    }
