  "ballotMeasures": [
    {
      "title": "Lubbock, Texas, Proposition A, Annexation Measure (November 2024)",
      "propositionId": "A",
      "fullText": "\u201cShall the City of Lubbock (the city) annex approximately 374.74 acres commonly known as the Highland Oaks subdivision and located within an area south of 146th Street (F.M. 7500), east of Frankford Avenue, north of Woodrow Road (F.M. 7600), and west of Slide Road (F.M. 1730), thereby including the area inside the full-purpose city limits of the city, resulting in the city providing municipal services in accordance with Texas Local Government Code Section 43.0692; the area shall be subject to the jurisdiction, laws, and regulations of the city; and the city shall impose a property tax each year on all property in the area at the same rate that is imposed on other property in the city?\u201d",
      "type": "Ballot Measure",
      "level": "City-town"
    },
    {
      "title": "Lubbock, Texas, Proposition A, Street Improvements Bond Measure (November 2024)",
      "propositionId": "A",
      "fullText": "\u201cThe issuance of $103,400,000 general obligation bonds for street improvements, and the imposition of taxes sufficient to pay the principal of and interest on the bonds.\u201d",
      "type": "Ballot Measure",
      "level": "City-town"
    }
